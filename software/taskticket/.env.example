# Required Trello configuration. Do not commit the populated .env file.
TRELLO_API_KEY=
TRELLO_TOKEN=
TRELLO_BOARD_ID=

# Local selection is the default and makes no model calls.
TASKTICKET_USE_AI=0
TASKTICKET_AI_MODEL=qwen/qwen3.7-flash
OPENROUTER_API_KEY=
TASKTICKET_FOCUS_MINUTES=15
TASKTICKET_TIMEZONE=Europe/Luxembourg

# Original ESC/POS USB printer. Confirm these for your own device.
PRINTER_VENDOR_ID=0x0416
PRINTER_PRODUCT_ID=0x5011
PRINTER_IN_EP=0x82
PRINTER_OUT_EP=0x01
PRINTER_DEBUG=false
# Task tickets include a small logo. Set to 0 for text-only task tickets.
PRINTER_TASK_LOGO=1
PRINTER_WIDTH_DOTS=576
